[Unit]
Description=LSOB V20 ADA support resistance paper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/TB-1
ExecStart=/root/TB-1/venv/bin/python -u /root/TB-1/live_paper_v20_ada.py run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
