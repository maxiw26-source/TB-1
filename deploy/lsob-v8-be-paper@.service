[Unit]
Description=LSOB V8 %i independent 2R break-even paper experiment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/TB-1
ExecStart=/root/TB-1/venv/bin/python -u /root/TB-1/live_paper_v8_be.py %i
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
