[Unit]
Description=LSOB V8 ADA Expiry2 FVG015 Paper Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/TB-1
ExecStart=/root/TB-1/venv/bin/python -u /root/TB-1/live_paper_v8_ada.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
