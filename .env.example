# Bitunix credentials
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live execution stays OFF by default.
ENABLE_LIVE_EXECUTION=false

# Second deliberate arming key.
# Only set this exact value when you intentionally want
# approved plans to become real Bitunix orders:
LIVE_EXECUTION_ACK=

# Hard safety limits
LIVE_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
LIVE_MAX_NOTIONAL_USDT=10
LIVE_MAX_ENTRY_DEVIATION_PERCENT=0.20
LIVE_MAX_APPROVAL_AGE_SECONDS=120
LIVE_MAX_COST_TO_RISK_RATIO=0.12
LIVE_TAKER_FEE_PERCENT=0.06
LIVE_SLIPPAGE_PERCENT=0.02

# Must match the Bitunix futures account mode.
BITUNIX_POSITION_MODE=ONE_WAY


# Live partial-profit execution stays OFF until API tests are complete.
ENABLE_LIVE_PARTIALS=false
LIVE_PARTIALS_ACK=


# Unattended real entries stay OFF by default.
# When enabled with the exact ACK below, new valid V7 entry plans
# are automatically approved and still pass every existing live preflight.
ENABLE_AUTO_LIVE_EXECUTION=false
AUTO_LIVE_EXECUTION_ACK=
